{
  "task_description": "{'component_name': 'Main Container for NeuroQuest: The Productivity RPG', 'description': 'Primary container for NeuroQuest: The Productivity RPG implementation: NeuroQuest is a gamified productivity RPG web app where users set a major life goal, which is transformed into AI-generated quests and tasks. The app features XP, levels, boss battles (deadlines), a focus engine, and RPG-style progression. Users can log in, set goals, track progress, battle deadlines, earn cosmetics, and sync with Google Calendar. The UI is a futuristic-fantasy hybrid, fully responsive, and leverages React, Vite, TailwindCSS, Firebase, OpenAI GPT, and Google Calendar API.', 'framework': 'vite', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Login with Google or Email/Password using Firebase Auth. Persistent sessions via localStorage/context.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-Generated Quest Roadmap",\n      "description": "Users enter a major goal and deadline; OpenAI GPT generates a personalized quest roadmap, stored in Firestore.",\n      "isEnabled": true\n    },\n    {\n      "name": "Gamified Dashboard (The Kingdom)",\n      "description": "Central hub with XP/HP bars, avatar, quest zones (Focus Forest, Deadline Dungeon, Daily Hills), floating quest orb, and quick stats.",\n      "isEnabled": true\n    },\n    {\n      "name": "Quest Log",\n      "description": "Full view of all quests and tasks, with sections for main questline, side quests, and microtasks. Tasks can be completed, added, reordered, or rewritten by AI.",\n      "isEnabled": true\n    },\n    {\n      "name": "Boss Battles",\n      "description": "Timed challenges tied to real deadlines, with dramatic UI, countdown, and animated enemies. Success/failure affects XP/HP.",\n      "isEnabled": true\n    },\n    {\n      "name": "Focus Engine",\n      "description": "Simulates productivity tracking with a focus meter, status, and XP increments. Tracks streaks and focus activity.",\n      "isEnabled": true\n    },\n    {\n      "name": "Inventory & Cosmetics",\n      "description": "Grid of earned cosmetics and tokens. Users can equip items, unlock new cosmetics at levels, and earn tokens via boss wins.",\n      "isEnabled": true\n    },\n    {\n      "name": "Google Calendar Sync",\n      "description": "Syncs with Google Calendar to fetch events, convert them to boss battles, and display upcoming events.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settings & Preferences",\n      "description": "User can toggle dark/light mode, animations, start new quest, and logout. Preferences update UI context.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive Design",\n      "description": "App is fully responsive and looks great on mobile, tablet, and desktop.",\n      "isEnabled": true\n    },\n    {\n      "name": "Neon-Glow UI Effects",\n      "description": "Buttons and interactive elements have neon-glow effects, rounded corners, and smooth transitions.",\n      "isEnabled": true\n    },\n    {\n      "name": "Lottie Animations",\n      "description": "Animated feedback for victories, level-ups, and boss battles using Lottie.",\n      "isEnabled": true\n    },\n    {\n      "name": "Voice Input (Optional)",\n      "description": "Voice command support for quest input and navigation.",\n      "isEnabled": false\n    },\n    {\n      "name": "Bonus AI Features (Future)",\n      "description": "Meditation mode, Pomodoro timer, XP graphs, voice commands, and gamepad navigation for PWA.",\n      "isEnabled": false\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#0f172a",\n    "secondary": "#f8fafc",\n    "accent": "#7c3aed"\n  },\n  "theme": "auto",\n  "layoutDescription": "The UI features a futuristic-fantasy RPG theme with a midnight navy background, violet accents, neon-glow buttons, and rounded elements. The dashboard is RPG-style with XP/HP bars at the top, avatar and zones in the center, and floating quest orb. All pages are responsive, with mobile-first layouts and smooth transitions. Key components (XPBar, HPBar, QuestCard, Avatar, FocusMeter, FloatingOrb, LottieAnim) are modular and reusable. Each page (Login, Onboarding, Dashboard, QuestLog, BossBattle, FocusEngine, Inventory, CalendarSync, Settings) is a separate route, managed by React Router. Context is used for global state (XP, HP, user, streak)."\n}'}",
